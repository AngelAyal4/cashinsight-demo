# MongoDB
MONGODB_URI=mongodb://localhost:27017/cashinsightapp

# JWT Secret (generar con: openssl rand -base64 32)
JWT_SECRET=your-jwt-secret-here-change-in-production

# App Config
NEXT_PUBLIC_APP_NAME=CashinsightApp
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Produccion (Docker): copiar a .env.production (gitignored) con
# MONGODB_URI=mongodb://mongo:27017/cashinsightapp y JWT_SECRET=$(openssl rand -base64 32)

# Modo Demo (true = sin auth, usuario hardcodeado)
# Usar en deploys públicos para recruiters
NEXT_PUBLIC_DEMO_MODE=false
